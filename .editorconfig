root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,cxx,cc,h,hpp,hxx}]
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml,md,xaml,xml,props,targets,vcxproj,sln}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
